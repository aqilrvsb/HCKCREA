# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local-only secret seed files — never commit
*.secrets.sql
supabase/seeds/local*.sql
.local-secrets/
.playwright-mcp/

# Demo binaries — uploaded to Supabase Storage, manifest references public URLs
public/demos/*.mp4
public/demos/*.png
public/demos/*.jpg
public/demos/*.webp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Local playbook / GPT-instruction / sales-copy drafts (keep out of the repo)
GROK_ALGORITHM_PLAYBOOK.md
NL_LAB_EXPERT_PLAYBOOK.md
NL_LAB_GPT_BUILD.md
NL_LAB_SALES_COPY.md
NL_LAB_UPGRADED_INSTRUCTIONS.md
NL_LAB_vs_EXAMPLE_BENCHMARK.md
PENINGLAB_GPT_INSTRUCTIONS.md
__pycache__/
