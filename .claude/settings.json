{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__scrapling",
      "mcp__supabase",
      "mcp__playwright",
      "mcp__vercel"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PROJECT_DIR + '/.claude/hooks/git-safe-directory.cjs')\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PROJECT_DIR + '/.claude/hooks/sync-history.cjs')\"",
            "timeout": 300,
            "statusMessage": "Restoring conversation history from .claude-history"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PROJECT_DIR + '/.claude/hooks/sync-history.cjs')\"",
            "async": true,
            "timeout": 300
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(process.env.CLAUDE_PROJECT_DIR + '/.claude/hooks/sync-history.cjs')\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
